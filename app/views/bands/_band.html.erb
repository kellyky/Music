<div id="<%= dom_id band %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= band.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Genre:</strong>
    <%= band.genre %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Musicians:</strong>
    <ul>
    <% band.memberships.each do |member| %>
      <li><%= member.musician.name %> (<%= member.active ? "Active" : "Inactive" %>)</li>
    <% end %>
    </ul>
  </div>
</div>
